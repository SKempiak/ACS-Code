{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug a built program",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/${input:program}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "osx": { "MIMode": "lldb" },
      "linux": { "MIMode": "gdb" }
    }
  ],
  "inputs": [
    {
      "id": "program",
      "type": "promptString",
      "description": "Program to debug, relative to the repository root",
      "default": "SIMD_Advantage_Profiling/code/build/autovec/simd_bench"
    }
  ]
}
