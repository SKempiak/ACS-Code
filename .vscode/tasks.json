{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build: all C projects",
      "type": "shell",
      "command": "make",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": ["search", { "include": ["${workspaceFolder}"] }]
      },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Build: SIMD_Advantage_Profiling",
      "type": "shell",
      "command": "make",
      "options": { "cwd": "${workspaceFolder}/SIMD_Advantage_Profiling/code" },
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": ["autoDetect", "${workspaceFolder}/SIMD_Advantage_Profiling/code"]
      },
      "group": "build"
    },
    {
      "label": "Test: SIMD_Advantage_Profiling (make test)",
      "type": "shell",
      "command": "make test",
      "options": { "cwd": "${workspaceFolder}/SIMD_Advantage_Profiling/code" },
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": ["autoDetect", "${workspaceFolder}/SIMD_Advantage_Profiling/code"]
      },
      "group": "test"
    },
    {
      "label": "Build: Cache_and_Memory_Performance_Profiling",
      "type": "shell",
      "command": "make",
      "options": { "cwd": "${workspaceFolder}/Cache_and_Memory_Performance_Profiling/code" },
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": ["autoDetect", "${workspaceFolder}/Cache_and_Memory_Performance_Profiling/code"]
      },
      "group": "build"
    },
    {
      "label": "Clean: all",
      "type": "shell",
      "command": "make clean",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
